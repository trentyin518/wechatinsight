# Environment template for backend + worker.
# Copy to .env and fill in real values. Never commit .env.

# Runtime environment: development | production
APP_ENV=development

# Database URL.
# Local zero-config default (SQLite) is used if unset:
#   sqlite+pysqlite:///./dev.db
# Production MUST use PostgreSQL, e.g.:
#   postgresql+psycopg://user:pass@host:5432/wechat_insight
DATABASE_URL=sqlite+pysqlite:///./dev.db

# Third-party provider keys (server-side only; never prefix with NEXT_PUBLIC_)
QOVIA_API_KEY=
QOVIA_BASE_URL=https://api.qovia.example.com
XMEDI_API_KEY=
XMEDI_BASE_URL=https://api.xmedi.example.com

# Which provider adapter is active by default: mock | qovia | xmedi
DEFAULT_PROVIDER=mock

# CORS allow-list for the frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:3000

# Cost controls
DAILY_BUDGET_USD=5.0
MONTHLY_BUDGET_USD=100.0

# Search / cold-start controls
ALLOW_COLD_START_SEARCH=true
SEARCH_RATE_LIMIT_PER_MINUTE=30
# Identical keywords are answered from search_cache instead of a billed call.
# Empty results are kept longer because they are the ones users retype.
SEARCH_CACHE_TTL_HOURS=24
EMPTY_SEARCH_CACHE_TTL_HOURS=168

# --- Authentication & onboarding ---
# Require an approved, logged-in session for data endpoints. Ship endpoints with
# this false, then flip to true to enforce (and back to false to roll back).
AUTH_ENFORCED=false
# Session lifetime + cookie + a secret used to sign the WeChat OAuth state.
# Set a strong random SESSION_SECRET in production.
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=wi_session
SESSION_SECRET=dev-insecure-change-me
# Where users land after login / WeChat callback.
FRONTEND_BASE_URL=http://localhost:3000

# WeChat 网站应用 OAuth2 (real QR login). Leave blank to use mock login in dev.
# In production these are required and mock login is disabled.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8000/api/v1/auth/wechat/callback
WECHAT_STATE_TTL_SECONDS=600

# Onboarding proof uploads (local dir + size cap in MB). Persist UPLOAD_DIR in prod.
PROOF_MAX_MB=5
UPLOAD_DIR=

# Idempotently bootstrapped admin account for reviewing onboarding submissions.
ADMIN_PHONE=
ADMIN_PASSWORD=
